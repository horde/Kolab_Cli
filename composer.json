{
    "name": "horde/kolab_cli",
    "description": "Kolab storage command line interface library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Kolab_Cli",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Gunnar Wrobel",
            "email": "p@rdus.de",
            "role": "lead"
        }
    ],
    "time": "2026-06-28",
    "repositories": [],
    "require": {
        "php": "^7.4 || ^8",
        "horde/autoloader": "^3 || dev-FRAMEWORK_6_0",
        "horde/cli": "^3 || dev-FRAMEWORK_6_0",
        "horde/cli_modular": "^3 || dev-FRAMEWORK_6_0",
        "horde/imap_client": "^3 || dev-FRAMEWORK_6_0",
        "horde/kolab_storage": "^3 || dev-FRAMEWORK_6_0",
        "horde/log": "^3 || dev-FRAMEWORK_6_0",
        "horde/translation": "^3 || dev-FRAMEWORK_6_0",
        "horde/util": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {},
    "suggest": {
        "horde/support": "^3 || dev-FRAMEWORK_6_0",
        "horde/test": "^3 || dev-FRAMEWORK_6_0",
        "horde/yaml": "^3 || dev-FRAMEWORK_6_0"
    },
    "autoload": {
        "psr-0": {
            "Horde_Kolab_Cli": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Kolab\\Cli\\Test\\": "test/"
        }
    },
    "bin": [
        "bin/horde-kolab-cli"
    ],
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "1.x-dev"
        }
    }
}